[TEMPLATE]
# ─────────────────────────────────────────────────────────────
# Boba Bash Workshops — environment variables
# Copy to .env (local) and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon recommended for Vercel).
# Use the pooled connection string (with -pooler) for serverless.
DATABASE_URL=

# Public URL of the deployed app (no trailing slash), used in metadata and
# attendee access links.
# Local: http://localhost:3000 — Production: https://workshops.bobabashlahore.xyz
NEXT_PUBLIC_APP_URL=http://localhost:3000

# That's all — two variables. Workshops are online-only, the platform sends no
# email, and no file/object storage provider is used, so there are no email,
# cron or storage variables to configure.
