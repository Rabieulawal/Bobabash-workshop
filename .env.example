# ─────────────────────────────────────────────────────────────
# Boba Bash Workshops — environment variables
# Copy to .env (local) and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon recommended for Vercel).
# Use the pooled connection string (with -pooler) for serverless.
DATABASE_URL=

# Secret used to sign/derive session-token hashes. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=

# Resend API key (https://resend.com). Leave blank to log emails to console.
RESEND_API_KEY=

# From address for transactional email, e.g. "Boba Bash <no-reply@bobabashlahore.xyz>"
EMAIL_FROM=

# Public URL of the deployed app (no trailing slash), used in emails & metadata.
# Local: http://localhost:3000 — Production: https://workshops.bobabashlahore.xyz
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional ────────────────────────────────────────────────

# Protects /api/cron/send-reminders. Generate with: openssl rand -hex 24
CRON_SECRET=

# Set to "true" only while seeding a FRESH production database (then remove).
# Allows seeding the super admin without exposing weak default credentials.
ALLOW_PRODUCTION_SEED=false
